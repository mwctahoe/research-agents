{
  "name": "snake_game",
  "version": "1.0.0",
  "description": "A classic Snake game implemented in Electron with React and WebGL",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run start:dev\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "vite": "^5.0.12",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  }
}
